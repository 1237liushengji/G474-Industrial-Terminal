# EditorConfig - https://editorconfig.org
# Works for most editors/IDEs (Keil uVision ignores it; used by VS Code,
# CLion, Vim, etc. for the PC tooling and docs).

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,h}]
indent_style = space
indent_size = 4
max_line_length = 100

[*.{py}]
indent_style = space
indent_size = 4
max_line_length = 79

[*.{md}]
trim_trailing_whitespace = false

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2
